# ============================================================
# Database
# ============================================================
POSTGRES_USER=taskrabbit
POSTGRES_PASSWORD=changeme
POSTGRES_DB=taskrabbit

# Local development Vault only. Generate a random value before running the stack;
# runtime services never receive this bootstrap/root token.
VAULT_DEV_ROOT_TOKEN=replace_with_a_random_local_development_vault_root_token
# Password for the dedicated vault_db_admin PostgreSQL user (CREATEROLE only)
# that Vault's database secrets engine manages lease roles with.
VAULT_DB_ADMIN_PASSWORD=replace_with_a_random_vault_db_admin_password

DATABASE_URL=postgresql://taskrabbit:changeme@db:5432/taskrabbit

# ============================================================
# Auth
# ============================================================
APP_ORIGIN=http://localhost:8080
AUTH_INTERNAL_TOKEN=change_this_internal_token_at_least_32_chars
AUTH_REFRESH_SUCCESSOR_KEY=change_this_refresh_successor_key_at_least_32_chars
AUTH_REFRESH_COOKIE=tr_refresh
AUTH_CSRF_COOKIE=tr_csrf
AUTH_COOKIE_SECURE=false
AUTH_REFRESH_IDLE_TTL=168h
AUTH_REFRESH_ABSOLUTE_TTL=720h
AUTH_JWT_ISSUER=http://localhost:8080/auth
AUTH_JWT_AUDIENCE=transcendence-api
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_LEEWAY=30s

# 2FA
TOTP_ISSUER=TaskRabbit

# OAuth — 42
OAUTH_42_CLIENT_ID=
OAUTH_42_CLIENT_SECRET=

# OAuth — Google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# OAuth — GitHub (reserved for a future provider)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ============================================================
# Services (internal Docker network URLs)
# ============================================================
AUTH_SERVICE_URL=http://auth:3001

# ============================================================
# Frontend (exposed to the browser — use public hostname in prod)
# ============================================================
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws

# ============================================================
# RustFS
# ============================================================
RUSTFS_SERVER_DOMAINS=rustfs
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_ACCESS_KEY=taskrabbit
RUSTFS_SECRET_KEY=changeme
# Backend -> RustFS S3 API (internal Docker network URL)
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_BUCKET=task-rabbit-test
RUSTFS_REGION=us-east-1