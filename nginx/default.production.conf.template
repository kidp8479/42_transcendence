limit_req_zone $binary_remote_addr zone=ws_handshake_rate:10m rate=120r/m;
limit_conn_zone $binary_remote_addr zone=ws_handshake_concurrency:10m;
limit_req_zone $binary_remote_addr zone=project_api_token_rate:10m rate=60r/m;

log_format ws_redacted '$remote_addr - $remote_user [$time_local] '
                       '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                       '"$http_referer" "$http_user_agent"';

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $host $direct_https_host {
    default "";
    tomato.iops.dev tomato.iops.dev;
    tomato-dev.iops.dev tomato-dev.iops.dev;
}

server {
    listen 8080 default_server;
    server_name _;
    return 444;
}

server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 8443 ssl;
    server_name tomato.iops.dev tomato-dev.iops.dev;

    ssl_certificate /etc/nginx/ssl/public-domains.pem;
    ssl_certificate_key /etc/nginx/ssl/public-domains.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    if ($direct_https_host = "") {
        return 444;
    }

    include /etc/nginx/includes/error-pages.conf;
    include /etc/nginx/includes/application-locations.conf;
}
